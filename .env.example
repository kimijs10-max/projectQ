# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real tokens.

# IBKR Flex Web Service (Account Management > Reports > Flex Queries)
FLEX_TOKEN=your_flex_token_here
FLEX_QUERY_ID=your_flex_query_id_here

# IB Gateway (live, read-only) — Gateway must have "Read-Only API" enabled
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=1
